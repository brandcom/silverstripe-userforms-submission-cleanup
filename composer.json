{
    "name": "brandcom/silverstripe-userforms-submission-cleanup",
    "description": "(In development) Deletes Silverstripe userforms submissions older than a retention window, including field rows, uploaded files and their version history",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "userforms",
        "gdpr",
        "dsgvo",
        "retention",
        "cleanup"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "brandcom",
            "homepage": "https://www.brandcom.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.2.13",
        "silverstripe/assets": "^3.2.4",
        "silverstripe/versioned": "^3.2.1",
        "silverstripe/userforms": "^7.1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Brandcom\\UserFormsSubmissionCleanup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brandcom\\UserFormsSubmissionCleanup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "installer-name": "userforms-submission-cleanup"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
