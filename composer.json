{
    "name": "brandcom/silverstripe-userforms-submission-cleanup",
    "description": "Deletes Silverstripe userforms submissions older than a retention window, including field rows, uploaded files and their version history",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "userforms", "gdpr", "dsgvo", "retention", "cleanup"],
    "license": "MIT",
    "authors": [
        {
            "name": "brandcom",
            "homepage": "https://www.brandcom.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/assets": "^3",
        "silverstripe/versioned": "^3",
        "silverstripe/userforms": "^7"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Brandcom\\UserFormsSubmissionCleanup\\": "src/"
        }
    },
    "extra": {
        "installer-name": "userforms-submission-cleanup"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
